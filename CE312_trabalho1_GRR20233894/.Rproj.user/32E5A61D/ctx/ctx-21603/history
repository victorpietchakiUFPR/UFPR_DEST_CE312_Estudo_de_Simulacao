res_ln <- as.data.frame(t(res_ln))
path <- paste0("01_data//res_ln_", "n", n, "_B", B, "_ncens", n_cens_perc, ".RData")
save(res_ln, file = path)
colnames(res_ln) <- c("Percentual_Censura", "Vies")
