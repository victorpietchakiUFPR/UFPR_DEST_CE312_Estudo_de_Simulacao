# ________________________________________________________
# ================ 0. PACOTES NECESSÁRIOS ================
# ________________________________________________________
library(tidyverse)
library(survival)
library(flexsurv)


# ________________________________________________________
# ================= 1. EXTRAÇÃO DE DADOS =================
# ________________________________________________________
dados <- read_csv("01_data//lifetime.csv")
dados <- subset(dados, vehicle_cutoff_kms <= 1e6) %>%
  select(vehicle_cutoff_kms, event)
names(dados) <- c("time", "event")


# ________________________________________________________
# ======================= 2. SETUP =======================
# ________________________________________________________
set.seed(42)

# Níveis de censura para estudo
niveis_censura <- c(0.00, 0.10, 0.20, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80)

# Número de simulações por nível de censura
B <- 500

# Tamanho amostral
n <- nrow(dados)


# ________________________________________________________
# ================= 3. ESTIMAÇÃO DE S(t) =================
# ________________________________________________________

# Modelo Não-Paramétrico: Estimador de Kaplan-Meier
ekm <- survfit(
   Surv(tempos,cens) ~ 1
  ,data = dados
)

# Modelo Paraamétrico: Distribuição Gamma Generalizada
fit <- flexsurvreg(
   Surv(time, event) ~ 1
  ,data = dados
  ,dist = "gengamma"
)
# Extraindo estimativas pontuais
params    <- fit$res
mu_hat    <- params["mu"   , "est"]
sigma_hat <- params["sigma", "est"]
Q_hat     <- params["Q"    , "est"]


# ________________________________________________________
# ===================== 3. BOOTSTRAP =====================
# ________________________________________________________

## ________________________________________________________
## =============== 3.1 AMOSTRAGEM ALEATÓRIA ===============
## ________________________________________________________


tau <- seq(
   quantile(dados$time, 0.05)
  ,quantile(dados$time, 0.95)
  ,length.out = 10
)
T_ <- rgengamma(n, mu_hat, sigma_hat, Q_hat)
C_ <- runif(n, 0, tau[1])
dados.boot <- data.frame(
   time = pmin(T_, C_)
  ,event = as.integer(T_ <= C_)
)

fit.boot <- flexsurvreg(
   Surv(time, event) ~ 1
  ,data = dados.boot
  ,dist = "gengamma"
)

fit$res
fit.boot$res
